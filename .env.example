# Copier ce fichier en `.env` puis remplir les valeurs.
# `DB_PASSWORD` doit être identique au mot de passe présent dans `DATABASE_URL`.

DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://infos_elus_user:CHANGE_ME@localhost:5433/infos_elus
PAYLOAD_SECRET=CHANGE_ME
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Emails transactionnels (double opt-in newsletter) ---
# Relais SMTP de Brevo. Sans SMTP_USER ni SMTP_PASSWORD, les emails sont
# seulement journalisés dans la console : le parcours reste testable sans compte.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Infos Élus

# --- Liste de diffusion Brevo (API HTTP) ---
# Clé API v3 et identifiant numérique de la liste recevant les abonnés confirmés.
BREVO_API_KEY=
BREVO_LIST_ID=
